{
  "name": "sledge-review",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "node --test mobileOcr.test.js review.test.js review.cases.test.js packet.test.js corpus.test.js && npm run test:reader",
    "test:reader": ".venv/bin/python -m unittest discover -s service -t . -p 'test_*.py'",
    "reader": ".venv/bin/python -m service.extract",
    "android:demo": "bash scripts/android-demo.sh",
    "extract": "node scripts/extract-packet.js",
    "evaluate": "node scripts/evaluate.js",
    "corpus:build": ".venv/bin/python -m evaluation.corpus.build",
    "evaluate:corpus": "node scripts/evaluate-corpus.js",
    "evaluate:ocr": "node evaluation/ocr/score.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "babel-preset-expo": "55.0.25",
    "expo": "~55.0.0",
    "expo-build-properties": "55.0.18",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-sqlite": "~55.0.20",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-blob-util": "0.24.11",
    "react-native-executorch": "0.11.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-worklets": "0.10.4"
  },
  "react-native-executorch": {
    "backends": [
      "xnnpack"
    ],
    "libs": [
      "opencv"
    ]
  }
}
