{
  "expo": {
    "name": "Sledge Review",
    "slug": "sledge-review",
    "version": "0.1.0",
    "android": {
      "package": "com.pushkar.constructionreview"
    },
    "ios": {
      "bundleIdentifier": "com.pushkar.constructionreview"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          },
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "./plugins/withOcrAndroid"
    ]
  }
}
